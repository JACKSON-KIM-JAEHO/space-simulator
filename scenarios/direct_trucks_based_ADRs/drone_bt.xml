<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="drone_behavior">
    <ReactiveSequence>
      <GatherLocalInfo/>
      <ReactiveSequence>
        <Sequence>
          <Fallback>
            <IsTruckArrviedAtDropoffLocation/>
            <DeployDrone/>
          </Fallback>
          <ReactiveFallback>
            <IsArrivedAtTaskLocation/>
            <MoveToTaskLocation/>
          </ReactiveFallback>
          <DropItem/>
        </Sequence>
        <Sequence>
          <IsTruckAssigned/>
          <Fallback>
            <IsArrivedAtTruck/>
            <MoveToTruck/>
          </Fallback>
          <DockToTruck/>
        </Sequence>
      </ReactiveSequence>
    </ReactiveSequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="DeployDrone"
            editable="true"/>
    <Action ID="DockToTruck"
            editable="true"/>
    <Action ID="DropItem"
            editable="true"/>
    <Action ID="GatherLocalInfo"
            editable="true"/>
    <Condition ID="IsArrivedAtTaskLocation"
               editable="true"/>
    <Condition ID="IsArrivedAtTruck"
               editable="true"/>
    <Condition ID="IsTruckArrviedAtDropoffLocation"
               editable="true"/>
    <Condition ID="IsTruckAssigned"
               editable="true"/>
    <Action ID="MoveToTaskLocation"
            editable="true"/>
    <Action ID="MoveToTruck"
            editable="true"/>
  </TreeNodesModel>

</root>
